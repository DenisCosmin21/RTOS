#include "globals.h"
#include "led.h"
#include "mutex.h"
#include "osKernel.h"
#include "rtos.h"
#include "uart.h"
#include <stdint.h>
#include <stdio.h>

// --- Global Flags & Shared Resources ---
volatile int pi_enabled = 0; // Accessed by mutex.c
volatile int start_low = 0;
volatile int extra_load = 0;

mutex_t demo_mutex;
mutex_t uart_mutex;

// --- Helper Functions ---
void busy_wait(int loops) {
  for (volatile int i = 0; i < loops + extra_load; i++)
    ;
}

// --- Tasks ---

// Task High: Priority 3 (Period 20ms)
// Needs mutex, sensitive to deadlines.
void task_high(void) {
  while (1) {
    uint32_t t_start = rtos_now();

    // Log start
    mutex_lock(&uart_mutex);
    uart_printf("[H] Start T=%d\r\n", t_start);
    mutex_unlock(&uart_mutex);

    // Attempt to acquire shared resource
    mutex_lock(&demo_mutex);
    busy_wait(2000); // ~5ms execution (Critical Section)
    mutex_unlock(&demo_mutex);

    // Check Deadline
    uint32_t t_end = rtos_now();

    mutex_lock(&uart_mutex);
    if ((t_end - t_start) > 20) {
      uart_printf("[H] DEADLINE MISS! Duration: %d ms\r\n", (t_end - t_start));
      led_on(); // Visual Error
    } else {
      uart_printf("[H] OK. Duration: %d ms\r\n", (t_end - t_start));
      led_off();
    }
    mutex_unlock(&uart_mutex);

    rtos_task_wait();
  }
}

// Task Med: Priority 2 (Period 40ms)
// Interferes with Low (preempts it), causing Priority Inversion if Low holds
// mutex.
void task_med(void) {
  while (1) {
    mutex_lock(&uart_mutex);
    uart_printf("[M] Run\r\n");
    mutex_unlock(&uart_mutex);

    busy_wait(4000); // ~10ms execution
    rtos_task_wait();
  }
}

// Task Low: Priority 1 (Period 60ms)
// Holds mutex for a long time.
void task_low(void) {
  while (1) {
    if (!start_low) {
      // Wait for phase 2
      rtos_task_wait();
      continue;
    }

    mutex_lock(&uart_mutex);
    uart_printf("[L] Acquire Lock\r\n");
    mutex_unlock(&uart_mutex);

    mutex_lock(&demo_mutex);
    busy_wait(8000); // ~20ms execution (Critical Section)
    mutex_unlock(&demo_mutex);

    mutex_lock(&uart_mutex);
    uart_printf("[L] Release Lock\r\n");
    mutex_unlock(&uart_mutex);

    rtos_task_wait();
  }
}

// Task Controller: Lowest Priority (Period 1000ms)
// Manages Demo Phases
void task_controller(void) {
  static int seconds = 0;
  while (1) {
    mutex_lock(&uart_mutex);

    if (seconds == 0) {
      uart_printf("\r\n=== Phase 1: Baseline (H & M Running) ===\r\n");
    } else if (seconds == 5) {
      uart_printf("\r\n=== Phase 2: Priority Inversion (Low Starts) ===\r\n");
      // Low starts taking mutex.
      // Expectation: Low takes mutex. Med preempts Low. High waits for Low
      // (which is blocked by Med). -> MISS.
      start_low = 1;
    } else if (seconds == 15) {
      uart_printf(
          "\r\n=== Phase 3: Activate PI (Priority Inheritance) ===\r\n");
      // Enable fix. Low should inherit High's priority, preventing Med from
      // preempting it.
      pi_enabled = 1;
    } else if (seconds == 25) {
      uart_printf("\r\n=== Phase 4: Increase Load ===\r\n");
      // Push system to limit
      extra_load = 4000;
    }

    seconds++;
    mutex_unlock(&uart_mutex);

    rtos_task_wait();
  }
}

int main(void) {
  // Initialization
  uart_tx_init();
  led_init();

  mutex_init(&demo_mutex);
  mutex_init(&uart_mutex);

  osKernelInit();

  mutex_lock(&uart_mutex);
  uart_printf("Booting RTOS... Tick Rate: 1000 Hz\r\n");
  mutex_unlock(&uart_mutex);

  // Create Tasks
  // Func, ExecBudget(ms), Period(ms), Stack, Name
  // Priorities assigned by RMS based on Period (shorter=higher)

  rtos_task_create(&task_high, 5, 20, 1024, "High");
  rtos_task_create(&task_med, 10, 40, 1024, "Med");
  rtos_task_create(&task_low, 20, 60, 1024, "Low");
  // Controller runs once per second
  rtos_task_create(&task_controller, 5, 1000, 1024, "Control");

  // Start Scheduler
  rtos_start();

  return 0;
}
