#include "stm32u5xx.h"
#include <stdint.h>

// --- Configuration ---
// USART1 TX is on PA9 (AF7)
// STM32U5 uses GPDMA1 for peripherals

#define GPIOAEN     (1U << 0)
#define USART1EN    (1U << 14) // APB2ENR bit 14
#define GPDMA1EN    (1U << 0)  // AHB1ENR1 bit 0

#define SYS_FREQ    4000000UL
#define APB2_CLK    SYS_FREQ   // USART1 is on APB2
#define UART_BAUDRATE 115200

// GPDMA1 Request ID for USART1_TX (Check stm32u575xx.h for specific ID, usually 37)
// If your header doesn't define this, consult RM0456 Request Mapping.
#ifndef GPDMA1_REQUEST_USART1_TX
#define GPDMA1_REQUEST_USART1_TX 37
#endif

static uint16_t compute_uart_bd(uint32_t periph_clk, uint32_t baudrate);
static void uart_set_baudrate(uint32_t periph_clk, uint32_t baudrate);

// Function to initialize UART + DMA
void uart_dma_init(void)
{
    /* 1. Enable Clock Access */
    RCC->AHB2ENR1 |= GPIOAEN;          // GPIOA Clock
    RCC->APB2ENR  |= USART1EN;         // USART1 Clock
    RCC->AHB1ENR1 |= GPDMA1EN;         // GPDMA1 Clock

    /* 2. Configure PA9 as Alternate Function 7 (USART1_TX) */
    GPIOA->MODER &= ~(1U << 18);       // Clear bit 18
    GPIOA->MODER |= (1U << 19);        // Set bit 19 (AF Mode)

    // Set AF7 (0111) for PA9 (AFR[1] is AFRH, PA9 is index 1)
    GPIOA->AFR[1] |= (1U << 4);
    GPIOA->AFR[1] |= (1U << 5);
    GPIOA->AFR[1] |= (1U << 6);
    GPIOA->AFR[1] &= ~(1U << 7);

    /* 3. Configure UART Baudrate */
    uart_set_baudrate(APB2_CLK, UART_BAUDRATE);

    /* 4. Enable UART DMA Transmit Request */
    // This tells the UART to raise a signal to the DMA when TDR is empty
    USART1->CR3 |= USART_CR3_DMAT;

    /* 5. Enable UART Transmitter and Module */
    USART1->CR1 = USART_CR1_TE | USART_CR1_UE;
}

// Function to send data via DMA
void uart_send_dma(const uint8_t *buffer, uint16_t length)
{
    // Point to GPDMA1 Channel 0
    DMA_Channel_TypeDef *dma_channel = GPDMA1_Channel0;

    /* 1. Reset/Disable the Channel */
    if (dma_channel->CCR & DMA_CCR_EN) {
        dma_channel->CCR |= DMA_CCR_SUSP; // Suspend if active
        dma_channel->CCR |= DMA_CCR_RESET; // Reset
        dma_channel->CCR &= ~DMA_CCR_EN;  // Ensure disabled
    }

    // Clear any pending flags for Channel 0
    GPDMA1->IFCR = (DMA_IFCR_TCF0 | DMA_IFCR_HTF0 | DMA_IFCR_DTEF0 | DMA_IFCR_ULEF0);

    /* 2. Configure Control Register 1 (CTR1) */
    // SINC (Source Increment) = 1
    // DINC (Dest Increment)   = 0 (Always write to same TDR address)
    // DDW (Dest Data Width)   = 0 (Byte)
    // SDW (Source Data Width) = 0 (Byte)
    dma_channel->CTR1 = DMA_CTR1_SINC;

    /* 3. Configure Control Register 2 (CTR2) */
    // REQSEL: Select USART1_TX as the request source
    // DREQ: 1 (Destination Request - Peripheral controls flow)
    dma_channel->CTR2 = (GPDMA1_REQUEST_USART1_TX << DMA_CTR2_REQSEL_Pos);

    /* 4. Configure Addresses and Size */
    dma_channel->CBR1 = length;                 // Number of bytes
    dma_channel->CSAR = (uint32_t)buffer;       // Source: Memory Address
    dma_channel->CDAR = (uint32_t)&USART1->TDR; // Dest: UART Transmit Data Register

    /* 5. No Linked List (Linear Mode) */
    dma_channel->CLBAR = 0;

    /* 6. Enable the DMA Channel */
    dma_channel->CCR |= DMA_CCR_EN;
}

// --- Helper Functions ---
static void uart_set_baudrate(uint32_t periph_clk, uint32_t baudrate){
    USART1->BRR = compute_uart_bd(periph_clk, baudrate);
}

static uint16_t compute_uart_bd(uint32_t periph_clk, uint32_t baudrate)
{
    return ((periph_clk + (baudrate/2U))/baudrate);
}

// Example Main
int main(void)
{
    uint8_t my_data[] = "Hello DMA World!\r\n";

    uart_dma_init();

    while(1)
    {
        uart_send_dma(my_data, sizeof(my_data) - 1);

        // Add delay here or wait for transfer complete (TCF)
        for(int i=0; i<1000000; i++);
    }
}
