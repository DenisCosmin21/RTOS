#include "uart.h"
#include "stm32u5xx.h"
#include <stdint.h>

// --- Defines ---
#define GPIOAEN     (1U << 0)
#define UART1EN     (1U << 14) // Note: APB2ENR bit 14 is USART1
#define GPDMA1EN    (1U << 0)  // AHB1ENR

#define SYS_FREQ        4000000UL
#define APB2_CLK        SYS_FREQ  // USART1 is usually on APB2
#define UART_BAUDRATE   115200

#define CR1_TE      (1U << 3)
#define CR1_UE      (1U << 0)
#define CR3_DMAT    (1U << 7)  // DMA Enable Transmitter

#define ISR_TXE     (1U << 7)

// GPDMA Defines for STM32U5
// Request ID for USART1_TX is typically 25 (Check datasheet for specific package)
#define USART1_TX_DMA_REQ_ID  25

static uint16_t compute_uart_bd(uint32_t periph_clk, uint32_t baudrate);
static void uart_set_baudrate(uint32_t periph_clk, uint32_t baudrate);
static void uart_write(int ch);

// --- DMA Initialization ---
void dma_init(void) {
    /* 1. Enable GPDMA1 Clock */
    RCC->AHB1ENR |= GPDMA1EN;

    /* 2. Reset GPDMA1 Channel 0 configurations just in case */
    GPDMA1_Channel0->CCR &= ~GPDMA_CCR_EN;
}

void uart_tx_init(void)
{
    /* Enable clock access to GPIOA */
    RCC->AHB2ENR1 |= GPIOAEN;

    /* Set PA9 mode to alternate function mode */
    GPIOA->MODER &= ~(1U << 18);
    GPIOA->MODER |= (1U << 19);

    /* Set alternate function type to AF7 (USART1) for PA9 */
    // Pin 9 is in AFR[1] (AFRH). Pin 9 index is (9-8)*4 = 4.
    GPIOA->AFR[1] |= (1U << 4);
    GPIOA->AFR[1] |= (1U << 5);
    GPIOA->AFR[1] |= (1U << 6);
    GPIOA->AFR[1] &= ~(1U << 7);

    /* Enable clock access to USART1 */
    RCC->APB2ENR |= UART1EN;

    /* Configure baudrate */
    uart_set_baudrate(APB2_CLK, UART_BAUDRATE);

    /* Configure transfer direction */
    USART1->CR1 = CR1_TE;

    /* --- CHANGE 1: Enable DMA Mode for Transmitter --- */
    USART1->CR3 |= CR3_DMAT;

    /* Enable the UART module */
    USART1->CR1 |= CR1_UE;

    /* Initialize the DMA controller */
    dma_init();
}

// --- Old Polling Write (Keep this for printf/single bytes) ---
static void uart_write(int ch){
    while(!(USART1->ISR & ISR_TXE)){}
    USART1->TDR = (ch & 0xFF);
}

// --- NEW: DMA Write Function ---
// Use this to send strings/arrays efficiently
void uart_send_dma(uint8_t *data, uint16_t len)
{
    /* 1. Disable DMA Channel to configure it */
    GPDMA1_Channel0->CCR &= ~GPDMA_CCR_EN;
    while(GPDMA1_Channel0->CSR & GPDMA_CSR_IDLEF); // Wait for idle

    /* 2. Configure Control Register 1 (CTR1) */
    // SINC (Source Increment) = 1, DINC (Dest Increment) = 0
    // DDW (Dest Data Width) = 0 (Byte), SDW (Source Width) = 0 (Byte)
    GPDMA1_Channel0->CTR1 = (1U << 16) |  // SINC: Increment source (memory)
                            (0U << 14) |  // DINC: Fixed dest (UART TDR)
                            (0U << 0);    // DDATA/SDATA width: Byte

    /* 3. Configure Control Register 2 (CTR2) - Request Selection */
    // Set the Request ID for USART1_TX (Typically 25 on U5)
    GPDMA1_Channel0->CTR2 = (USART1_TX_DMA_REQ_ID << 0) & GPDMA_CTR2_REQSEL;
    GPDMA1_Channel0->CTR2 |= (0U << 30); // SWREQ = 0 (Hardware trigger)

    /* 4. Configure Block Register 1 (CBR1) - Transfer Length */
    GPDMA1_Channel0->CBR1 = len;

    /* 5. Set Source and Destination Addresses */
    GPDMA1_Channel0->CSAR = (uint32_t)data;         // Source: RAM buffer
    GPDMA1_Channel0->CDAR = (uint32_t)&USART1->TDR; // Dest: UART TDR

    /* 6. Enable the Channel */
    GPDMA1_Channel0->CCR |= GPDMA_CCR_EN;
}

int __io_putchar(int ch){
    uart_write(ch); // Keep using polling for printf single chars
    return ch;
}

static void uart_set_baudrate(uint32_t periph_clk, uint32_t baudrate){
    USART1->BRR = compute_uart_bd(periph_clk, baudrate);
}

static uint16_t compute_uart_bd(uint32_t periph_clk, uint32_t baudrate)
{
    return ((periph_clk + (baudrate/2U))/baudrate);
}
