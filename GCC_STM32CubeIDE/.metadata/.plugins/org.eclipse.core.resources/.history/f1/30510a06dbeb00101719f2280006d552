#include "timebase.h"
#include "stm32u5xx.h"

// Setăm frecvența dorită pentru RTOS (1000 Hz = 1ms)
#define TICK_HZ 1000

// Definiții standard SysTick (le-ai avut corect)
#define CTRL_ENABLE      (1U<<0)
#define CTRL_TICKINT     (1U<<1)
#define CTRL_CLCKSRC     (1U<<2)

volatile uint32_t g_curr_tick = 0;

// Incrementul pe tick (1 ms)
// Poți să-l faci variabil dacă vrei tick-uri de dimensiuni diferite
uint32_t tick_freq = 1;

// --- Funcții ---

// 1. Funcția apelată din SysTick_Handler (din stm32u5xx_it.c sau startup)
void tick_increment(void){
	g_curr_tick += tick_freq;
}

// 2. Citire atomică (simplificată)
uint32_t get_tick(void)
{
	return g_curr_tick; // Pe Cortex-M33 citirea de 32bit e atomică
}

// 3. Delay simplu (Busy Wait) - A se folosi doar înainte să pornească Scheduler-ul!
// După ce pornește RTOS-ul, vei folosi rtos_delay() care face context switch.
void delay(uint32_t delay_ms)
{
	uint32_t tickstart = get_tick();
	while((get_tick() - tickstart) < delay_ms){
        // Așteaptă
    }
}

// 4. Inițializare
void timebase_init(void)
{
    // Pas Critic: Actualizăm frecvența cunoscută a sistemului
    SystemCoreClockUpdate();

	// Dezactivăm SysTick în timpul configurării
    SysTick->CTRL = 0;

	// Calculăm LOAD dinamic bazat pe frecvența reală a CPU
    // Ex: 4.000.000 / 1000 = 4000 tick-uri pentru 1ms
	uint32_t load_value = (SystemCoreClock / TICK_HZ);

    // Verificăm să nu depășim 24 biți (0xFFFFFF)
    if(load_value > 0x00FFFFFF) {
        // Handle error (frecvență CPU prea mare pentru TICK_HZ prea mic)
        load_value = 0x00FFFFFF;
    }

	SysTick->LOAD = load_value - 1;
	SysTick->VAL = 0;

	// Setăm prioritatea la cel mai mic nivel (Important pentru RTOS!)
    // SysTick nu trebuie să blocheze întreruperi hardware (UART, SPI, etc.)
    NVIC_SetPriority(SysTick_IRQn, (1UL << __NVIC_PRIO_BITS) - 1);

	// Activăm: Clock Source Processor (Bit 2) | Interrupt (Bit 1) | Enable (Bit 0)
	SysTick->CTRL = CTRL_CLCKSRC | CTRL_TICKINT | CTRL_ENABLE;

	// Activarea globală a întreruperilor (dacă nu era deja făcută)
	__enable_irq();
}
