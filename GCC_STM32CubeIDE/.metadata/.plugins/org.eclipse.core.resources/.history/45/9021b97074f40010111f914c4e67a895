#include "semaphore.h"
#include "rms_scheduler.h"
#include "globals.h"

void semaphore_init(semaphore_t *sem, size_t initial) {
    sem->size = initial;
    queue_init(&sem->queue);
}

void semaphore_up(semaphore_t *sem) {
    __disable_irq();

    // Increment semaphore count FIRST
    sem->size++;

    // If tasks are waiting, wake one
    if (!queue_is_empty(&sem->queue)) {
        TCB_t *task = dequeue(&sem->queue);
        scheduler_add_task(task);
    }

    __enable_irq();
}

void semaphore_down(semaphore_t *sem) {
    __disable_irq();

    // If resource available, take it
    if (sem->size > 0) {
        sem->size--;
        __enable_irq();
        return;
    }

    // Otherwise block current task
    enqueue(&sem->queue, running_task);

    // Pick next task
    next_task = scheduler_get_task();

    // Context switch (IRQ state restored from next task)
    context_switch();

    // DO NOT re-enable IRQs here
}

void semaphore_clear(semaphore_t *sem) {
    __disable_irq();
    sem->size = 0;
    __enable_irq();
}
