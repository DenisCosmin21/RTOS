
#include <stdint.h>
#include <stdio.h>
#include "led.h"
#include "uart.h"
#include "mutex.h"
#include "semaphore.h"
#include "osKernel.h"
#include "globals.h"
#include "rtos.h"
#include "message_queue.h" // Added

typedef	uint32_t TaskProfiler;

// Global Queue
message_queue_t logging_queue;
uint32_t do_work=0;

volatile TaskProfiler Task0_Profiler, Task1_Profiler, Task2_Profiler;

// T3: Background Logger (Lowest Priority)
void task_logger(void) {
    void *msg;
    while(1) {
    	Task0_Profiler++;
        
        // Burst process logs when CPU is free from High/Med tasks
        if(logging_queue.count > 0) {
            while(logging_queue.count > 0) {
                 if(msg_queue_receive(&logging_queue, &msg, 0)) {
                    if(msg != NULL) {
                        // Print the log
                        uart_printf("%s", (char*)msg);
                        led_toggle(); 
                    }
                 }
            }
        } 
        
        // checking every 50ms implies it might have latency, 
        // but since it's background, it relies on available CPU time.
        rtos_task_wait();
    }
}

// T2: Periodic 20ms (~2ms execution)
void task_periodic_20ms(){
    while(1) {
        Task1_Profiler++;
        
        // Log Dispatch (via Queue to avoid UART blocking/latency impact on Jitter)
        // Format: [T2] D: <timestamp> DL: <deadline>
        char log_buf[50];
        // Note: In a real system, sprintf in a task is heavy, but for this demo it's acceptable
        // if we have budget. 2ms budget / 4MHz = 8000 cycles. sprintf is risky.
        // Let's rely on fixed strings + integer formatting in uart if possible,
        // or just simple messages.
        // Simple Trace:
        msg_queue_send(&logging_queue, "[T2] Run (20ms)\r\n", 0);
        
        // Simulate ~2ms work
        // Loop calibration: 2ms @ 4MHz.
        for(volatile int i=0; i<800; i++){
        	do_work++;
        }
        
        rtos_task_wait();
    }
}

// T1: Periodic 5ms (~0.8ms execution)
void task_periodic_5ms(void) {
    while(1) {
        Task2_Profiler++;
        
        // Log Dispatch
        msg_queue_send(&logging_queue, "[T1] Run (5ms)\r\n", 0);
        
        // Simulate ~0.8ms work
        for(volatile int i=0; i<300; i++){
        	do_work++;
        }
        
        rtos_task_wait();
    }
}


int main(void) {
    uart_tx_init();
    led_init();

    msg_queue_init(&logging_queue);
    
    osKernelInit();

    // Create Tasks
    // 3rd Arg is Period (ms). 2nd is ExecTime (ms).
    // RMS: 5ms < 20ms < 100ms.
    // Priorities auto-assigned: 5ms=High, 20ms=Med, Logger=Low.
    
    // T1: 5ms Period, 1ms Budget (Approx 0.8ms)
    rtos_task_create(&task_periodic_5ms, 1, 5, 1024, "T1_5ms");
    
    // T2: 20ms Period, 2ms Budget
    rtos_task_create(&task_periodic_20ms, 2, 20, 1024, "T2_20ms");
    
    // T3: Logger (Background), 20ms Budget, 100ms Period check
    rtos_task_create(&task_logger, 20, 100, 1024, "Logger");

    uart_printf("Starting RTOS Demo (T1=5ms, T2=20ms)...\r\n");
    osKernelLaunch(QUANTA);
}
