// --- Definitions for NUCLEO-U575ZI-Q ---
#define UART_BUFFER_SIZE 256

#define GPIOAEN     (1U << 0)
#define UART1EN     (1U << 14)
#define GPDMA1EN    (1U << 0)

#define SYS_FREQ        4000000UL
#define APB2_CLK        SYS_FREQ
#define UART_BAUDRATE   115200

#define CR1_TE      (1U << 3)
#define CR1_UE      (1U << 0)
#define CR3_DMAT    (1U << 7)

#define ISR_TXE     (1U << 7)

// --- GPDMA Register Bit Definitions ---
#define GPDMA_CCR_EN      (1U << 0)
#define GPDMA_CSR_IDLEF   (1U << 0)
#define GPDMA_CTR2_REQSEL_POS (0U)

#define USART1_TX_DMA_REQ_ID  25

// [CHANGE 2] Global RTOS Objects
mutex_t uart_mutex;           // The Mutex to protect the buffer
// [FIX 1] Add 'volatile' because this is shared between Task and ISR
TCB_t *uart_blocked_task = 0;

static void uart_write(int ch);
static uint8_t dma_buffer[UART_BUFFER_SIZE];

// External references to your scheduler (from your rtos/globals)

static uint16_t compute_uart_bd(uint32_t periph_clk, uint32_t baudrate) { return ((periph_clk + (baudrate/2U))/baudrate); }
static void uart_set_baudrate(uint32_t periph_clk, uint32_t baudrate){ USART1->BRR = compute_uart_bd(periph_clk, baudrate);
}

// --- Cache Maintenance ---
static void my_CleanDCache(uint32_t *addr, int32_t dsize) {
    if (dsize < 0) return;
    uint32_t op_size = (uint32_t)dsize;
    uint32_t op_addr = (uint32_t)addr;
    int32_t linesize = 32;

    op_size += (op_addr & (linesize - 1U));
    op_addr &= ~(linesize - 1U);

    while (op_size > 0U) {
        *(volatile uint32_t *)0xE000EF68 = op_addr;
        op_addr += linesize;
        op_size -= (op_size >= linesize) ? linesize : op_size;
    }
    __asm volatile ("dsb 0xF":::"memory");
}

// --- Initialization Functions ---
void dma_init(void) {
    RCC->AHB1ENR |= GPDMA1EN;
    GPDMA1_Channel0->CCR &= ~GPDMA_CCR_EN;

    // [CHANGE 3] Enable NVIC Interrupt for GPDMA1 Channel 0
    // This ensures the CPU jumps to the ISR when transfer completes
    NVIC_SetPriority(GPDMA1_Channel0_IRQn, 5); // Set a safe priority
    NVIC_EnableIRQ(GPDMA1_Channel0_IRQn);
}

void uart_tx_init(void)
{
    // [CHANGE 4] Initialize the Mutex
    mutex_init(&uart_mutex);

    RCC->AHB2ENR1 |= GPIOAEN;

    GPIOA->MODER &= ~(1U << 18);
    GPIOA->MODER |= (1U << 19);

    GPIOA->AFR[1] |= (1U << 4);
    GPIOA->AFR[1] |= (1U << 5);
    GPIOA->AFR[1] |= (1U << 6);
    GPIOA->AFR[1] &= ~(1U << 7);

    RCC->APB2ENR |= UART1EN;

    uart_set_baudrate(APB2_CLK, UART_BAUDRATE);
    USART1->CR1 = CR1_TE;
    USART1->CR3 |= CR3_DMAT;
    USART1->CR1 |= CR1_UE;

    dma_init();
}

static void uart_write(int ch){
    while(!(USART1->ISR & ISR_TXE)){}
    USART1->TDR = (ch & 0xFF);
}

// --- DMA Write Function ---
void uart_send_dma(uint8_t *data, uint16_t len)
{
    my_CleanDCache((uint32_t*)data, len);

    GPDMA1_Channel0->CCR &= ~GPDMA_CCR_EN;
    while( !(GPDMA1_Channel0->CSR & GPDMA_CSR_IDLEF) );


    GPDMA1_Channel0->CFCR = 0xFFFFFFFF;

    // [CHANGE 5] Enable TCIE (Transfer Complete Interrupt Enable)
    // We add (1U << 8) to enable the interrupt
    GPDMA1_Channel0->CTR1 = (1U << 3); // SINC: Increment source


    GPDMA1_Channel0->CTR2 = (USART1_TX_DMA_REQ_ID << GPDMA_CTR2_REQSEL_POS);
    GPDMA1_Channel0->CBR1 = len;
    GPDMA1_Channel0->CSAR = (uint32_t)data;
    GPDMA1_Channel0->CDAR = (uint32_t)&USART1->TDR;

    GPDMA1_Channel0->CCR |= (1U << 8) | (1U << 9) | GPDMA_CCR_EN;
}

// [CHANGE 6] Helper function to manually block the current task
// In your uart_send_dma_wait function
static void uart_send_dma_wait(void) {
    // 1. Disable Interrupts to check the flag safely
    __disable_irq();

    // 2. Check: Did the ISR already run?
    if (uart_blocked_task == 0) {
        // Yes! The transfer is done. Do NOT sleep.
        __enable_irq();
        return;
    }

    // 3. No, ISR hasn't run yet. Safe to dequeue.
    //scheduler_dequeue_prio(running_task->priority);
   // scheduler_sleep_task(running_task);

    // 4. Re-enable interrupts so the ISR can eventually fire
    __enable_irq();

    // 5. Switch Context
    // If the ISR fires *right now* (after enable_irq), it will
    // add us back to the queue. The context switch will just
    // pick us up again immediately. Safe!
    next_task = scheduler_get_task();
    context_switch();
}
void uart_printf(const char *format, ...) {
    mutex_lock(&uart_mutex);

    va_list args;
    va_start(args, format);
    int len = vsnprintf((char*)dma_buffer, UART_BUFFER_SIZE, format, args);
    va_end(args);

    if (len > 0) {
        if (len > UART_BUFFER_SIZE) len = UART_BUFFER_SIZE;

        // 1. Register intent
        uart_blocked_task = running_task;

        // 2. Start Hardware
        uart_send_dma(dma_buffer, (uint16_t)len);

        // 3. Wait (Safe Version)
        rtos_task_yeld();
    }

    mutex_unlock(&uart_mutex);
}
// [CHANGE 10] The Interrupt Service Routine
// [FIX 1] Improved ISR - Safe against IRQ Storms
void GPDMA1_CH0_IRQHandler(void) {
    // 1. Read Status Register (CSR) to see what happened
    uint32_t status = GPDMA1_Channel0->CSR;

    // 2. Check for Transfer Complete (Bit 8) OR Error (Bit 9)
    if (status & ((1U << 8) | (1U << 9))) {

        // 3. CRITICAL FIX: Clear ALL flags for this channel
        // Writing 1 to bits in CFCR clears the corresponding flags
        GPDMA1_Channel0->CFCR = 0xFFFFFFFF;

        // 4. Wake the task (only if we were actually blocking)
        if (uart_blocked_task != 0) {
            scheduler_add_task(uart_blocked_task);
            uart_blocked_task = 0;

            // 5. RMS Requirement: Trigger Context Switch immediately
            // If we don't do this, we wait for the next SysTick (latency!)
            SCB->ICSR |= SCB_ICSR_PENDSVSET_Msk;
        }
    }
}
int __io_putchar(int ch){
    uart_write(ch);
    return ch;
}
