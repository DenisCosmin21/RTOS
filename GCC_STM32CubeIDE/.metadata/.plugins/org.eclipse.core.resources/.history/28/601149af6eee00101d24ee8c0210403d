#include "uart.h"
#include "stm32u5xx.h"
#include <stdint.h>
#include <stdarg.h>
#include <stdio.h>

// ===============================================================================
//                         MANUAL HARDWARE DEFINITIONS
//          (Bypasses header file naming differences GPDMA vs DMA)
// ===============================================================================

// 1. Define the GPDMA Channel Structure manually
// This matches the hardware registers of the STM32U5 exactly.
typedef struct
{
  volatile uint32_t CCR;   // Channel control register
  volatile uint32_t CTR1;  // Channel transfer register 1
  volatile uint32_t CTR2;  // Channel transfer register 2
  volatile uint32_t CBR1;  // Channel block register 1
  volatile uint32_t CSAR;  // Channel source address register
  volatile uint32_t CDAR;  // Channel destination address register
  volatile uint32_t CTR3;  // Channel transfer register 3
  volatile uint32_t CBR2;  // Channel block register 2
  volatile uint32_t CLLR;  // Channel link list register
} My_GPDMA_Channel_TypeDef;

// 2. Define the Base Addresses for STM32U5
// GPDMA1 Base Address is always 0x40020000 on STM32U5
#define MY_GPDMA1_BASE        0x40020000UL

// Channel 0 is at offset 0x50 from the base
#define MY_GPDMA1_Channel0    ((My_GPDMA_Channel_TypeDef *)(MY_GPDMA1_BASE + 0x50UL))

// ===============================================================================

// --- Definitions for NUCLEO-U575ZI-Q ---
#define UART_BUFFER_SIZE 256

#define GPIOAEN     (1U << 0)
#define UART1EN     (1U << 14)
#define GPDMA1EN    (1U << 0)

#define SYS_FREQ        4000000UL
#define APB2_CLK        SYS_FREQ
#define UART_BAUDRATE   115200

#define CR1_TE      (1U << 3)
#define CR1_UE      (1U << 0)
#define CR3_DMAT    (1U << 7)

#define ISR_TXE     (1U << 7)

// Register Bit Definitions
#define MY_DMA_CCR_EN      (1U << 0)   // Channel Enable
#define MY_DMA_CSR_IDLEF   (1U << 0)   // Idle Flag
#define MY_DMA_REQ_SEL_POS (0U)

// GPDMA Request ID for USART1_TX is 25
#define USART1_TX_DMA_REQ_ID  25

static uint16_t compute_uart_bd(uint32_t periph_clk, uint32_t baudrate);
static void uart_set_baudrate(uint32_t periph_clk, uint32_t baudrate);
static void uart_write(int ch);
static uint8_t dma_buffer[UART_BUFFER_SIZE];

// --- Cache Maintenance ---
static void my_CleanDCache(uint32_t *addr, int32_t dsize) {
    if (dsize < 0) return;

    uint32_t op_size = (uint32_t)dsize;
    uint32_t op_addr = (uint32_t)addr;
    int32_t linesize = 32;

    op_size += (op_addr & (linesize - 1U));
    op_addr &= ~(linesize - 1U);

    while (op_size > 0U) {
        *(volatile uint32_t *)0xE000EF68 = op_addr;
        op_addr += linesize;
        op_size -= (op_size >= linesize) ? linesize : op_size;
    }
    __asm volatile ("dsb 0xF":::"memory");
}

// --- Initialization Functions ---
void dma_init(void) {
    /* 1. Enable GPDMA1 Clock */
    RCC->AHB1ENR |= GPDMA1EN;

    /* 2. Reset Channel 0 configuration */
    MY_GPDMA1_Channel0->CCR &= ~MY_DMA_CCR_EN;
}

void uart_tx_init(void)
{
    RCC->AHB2ENR1 |= GPIOAEN;

    // PA9 -> AF7 (USART1_TX)
    GPIOA->MODER &= ~(1U << 18);
    GPIOA->MODER |= (1U << 19);
    GPIOA->AFR[1] |= (1U << 4) | (1U << 5) | (1U << 6);
    GPIOA->AFR[1] &= ~(1U << 7);

    RCC->APB2ENR |= UART1EN;

    uart_set_baudrate(APB2_CLK, UART_BAUDRATE);
    USART1->CR1 = CR1_TE;
    USART1->CR3 |= CR3_DMAT;
    USART1->CR1 |= CR1_UE;

    dma_init();
}

static void uart_write(int ch){
    while(!(USART1->ISR & ISR_TXE)){}
    USART1->TDR = (ch & 0xFF);
}

// --- DMA Write Function ---
void uart_send_dma(uint8_t *data, uint16_t len)
{
    // 1. Flush Cache
    my_CleanDCache((uint32_t*)data, len);

    // 2. Disable DMA Channel
    MY_GPDMA1_Channel0->CCR &= ~MY_DMA_CCR_EN;

    // 3. Wait for IDLE (Use channel status from GPDMA1 status register if needed,
    //    but checking CCR enable bit is often sufficient for basic blocking)
    //    Strictly, we should check GPDMA1->CSR (Channel Status), but since we
    //    manually defined the channel, let's rely on the Enable bit for simplicity
    //    or define the Status Register if strictly needed.
    //    For now, waiting for EN bit to clear is safe enough in blocking mode.
    while(MY_GPDMA1_Channel0->CCR & MY_DMA_CCR_EN);

    // 4. Configure CTR1 (Control 1)
    // SINC=1 (bit 16), DINC=0 (bit 14), DDATA/SDATA=0 (Byte)
    MY_GPDMA1_Channel0->CTR1 = (1U << 16) |
                               (0U << 14) |
                               (0U << 0);

    // 5. Configure CTR2 (Control 2) - Request Selection
    MY_GPDMA1_Channel0->CTR2 = (USART1_TX_DMA_REQ_ID << MY_DMA_REQ_SEL_POS);

    // 6. Configure CBR1 (Block 1) - Transfer Length
    MY_GPDMA1_Channel0->CBR1 = len;

    // 7. Set Source and Destination
    MY_GPDMA1_Channel0->CSAR = (uint32_t)data;
    MY_GPDMA1_Channel0->CDAR = (uint32_t)&USART1->TDR;

    // 8. Enable the Channel
    MY_GPDMA1_Channel0->CCR |= MY_DMA_CCR_EN;
}

int __io_putchar(int ch){
    uart_write(ch);
    return ch;
}

static void uart_set_baudrate(uint32_t periph_clk, uint32_t baudrate){
    USART1->BRR = compute_uart_bd(periph_clk, baudrate);
}

static uint16_t compute_uart_bd(uint32_t periph_clk, uint32_t baudrate)
{
    return ((periph_clk + (baudrate/2U))/baudrate);
}

void uart_printf(const char *format, ...) {
    // Wait if DMA is busy
    while(MY_GPDMA1_Channel0->CCR & MY_DMA_CCR_EN);

    va_list args;
    va_start(args, format);
    int len = vsnprintf((char*)dma_buffer, UART_BUFFER_SIZE, format, args);
    va_end(args);

    if (len > 0) {
        if (len > UART_BUFFER_SIZE) len = UART_BUFFER_SIZE;
        uart_send_dma(dma_buffer, (uint16_t)len);
    }
}
