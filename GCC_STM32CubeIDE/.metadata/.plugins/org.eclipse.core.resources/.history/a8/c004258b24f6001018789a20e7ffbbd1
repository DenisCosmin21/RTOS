#include "ultrasonic.h"
#include "globals.h"

void ultrasonic_init(void) {
  RCC->AHB2ENR1 |= RCC_AHB2ENR1_GPIOFEN;
  GPIOF->MODER &= ~(3U << (ULTRASONIC_TRIG_PIN * 2));
  GPIOF->MODER |= (1U << (ULTRASONIC_TRIG_PIN * 2));

  GPIOF->MODER &= ~(3U << (ULTRASONIC_ECHO_PIN * 2));

  GPIOF->ODR &= ~(1U << ULTRASONIC_TRIG_PIN);
}

static void delay_us(uint32_t us) {
  uint32_t start = DWT->CYCCNT;
  uint32_t ticks = us * (SystemCoreClock / 1000000);
  while ((DWT->CYCCNT - start) < ticks)
    ;
}

float ultrasonic_read(void) {
  GPIOF->ODR |= (1U << ULTRASONIC_TRIG_PIN);
  delay_us(10);
  GPIOF->ODR &= ~(1U << ULTRASONIC_TRIG_PIN);

  uint32_t start_monitor = DWT->CYCCNT;
  uint32_t timeout_ticks = 10000 * (SystemCoreClock / 1000000); // 10ms

  while (!(GPIOF->IDR & (1U << ULTRASONIC_ECHO_PIN))) {
    if ((DWT->CYCCNT - start_monitor) > timeout_ticks)
      return -1.0f;
  }

  // 3. Measure High Time
  uint32_t start_pulse = DWT->CYCCNT;
  while (GPIOF->IDR & (1U << ULTRASONIC_ECHO_PIN)) {
    if ((DWT->CYCCNT - start_pulse) >
        (50000 * (SystemCoreClock / 1000000))) { // 50ms
      return -1.0f;
    }
  }
  uint32_t end_pulse = DWT->CYCCNT;

  uint32_t pulse_ticks = end_pulse - start_pulse;
  float time_us = (float)pulse_ticks / (SystemCoreClock / 1000000.0f);

  return (time_us * 0.0343f) / 2.0f;
}
